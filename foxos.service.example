[Unit]
Description=Fox OS — web desktop for headless servers
After=network.target

[Service]
Type=simple
# Change User/Group/WorkingDirectory/ExecStart for your install path
User=REPLACE_USER
Group=REPLACE_USER
WorkingDirectory=/opt/foxos
# waitress WSGI (bundled via requirements.txt) — not Flask's dev server
ExecStart=/usr/bin/python3 /opt/foxos/server.py
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# NoNewPrivileges=true  # disables sudo in Terminal PTY; leave false/off when allow_terminal
PrivateTmp=true

[Install]
WantedBy=multi-user.target
